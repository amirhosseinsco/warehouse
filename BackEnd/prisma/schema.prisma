generator client {
  provider = "prisma-client-js"
  output   = "generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  code        String    @unique
  description String?
  image_url   String?
  products    Product[] @relation("CategoryProducts")

  is_active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Brand {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  code        String    @unique
  description String?
  website     String?
  logo_url    String?
  country     String?
  is_active   Boolean   @default(true)
  products    Product[] @relation("BrandProducts")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Product {
  id            Int     @id @default(autoincrement())
  barcode       String  @unique
  internal_code String  @unique
  name          String
  description   String?

  category_id Int
  category    Category @relation("CategoryProducts", fields: [category_id], references: [id])

  brand_id Int
  brand    Brand @relation("BrandProducts", fields: [brand_id], references: [id])

  weight         Decimal?
  weight_unit    String?
  length         Decimal?
  width          Decimal?
  height         Decimal?
  dimension_unit String?
  selling_price  Int
  status         ProductStatus @default(ACTIVE)

  is_serialized    Boolean @default(false)
  is_batch_tracked Boolean @default(false)
  is_expirable     Boolean @default(false)

  has_variants Boolean @default(false)

  manufacturer             String?
  manufacturer_part_number String?
  model_number             String?

  country_of_origin String?

  created_by Int?
  updated_by Int?

  creator User? @relation("ProductCreatedBy", fields: [created_by], references: [id])
  updater User? @relation("ProductUpdatedBy", fields: [updated_by], references: [id])

  image_url String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  deletedAt DateTime?
  inventory Inventory[] @relation("ProductInventory")
}

enum WarehouseType {
  MAIN
  DISTRIBUTION
  RAW_MATERIAL
  FINISHED_GOODS
  COLD_STORAGE
  RETAIL
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
  CLOSED
}

model Warehouse {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String?

  warehouse_type WarehouseType
  status         WarehouseStatus @default(ACTIVE())

  address_line_1 String
  address_line_2 String?
  city           String
  state          String?
  country        String
  postal_code    String?

  latitude  Decimal?
  longitude Decimal?

  phone String?
  email String?

  manager_user_id Int?
  manager         User? @relation("WarehouseManager", fields: [manager_user_id], references: [id])

  capacity      Decimal?
  capacity_unit String?

  timezone String

  is_active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  inventory Inventory[] @relation("WarehouseInventory")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

model User {
  id                Int        @id @default(autoincrement())
  username          String     @unique
  email             String     @unique
  phone             String    @unique
  password_hash     String
  first_name        String
  last_name         String
  postal_code       String?
  avatar_url        String?
  employee_code     String?    @unique
  job_title         String?
  department_id     Int?
  status            UserStatus @default(ACTIVE)
  last_login_at     DateTime?
  email_verified_at DateTime?
  phone_verified_at DateTime?
  created_at        DateTime   @default(now())
  updated_at        DateTime   @updatedAt
  deleted_at        DateTime?

  managedWarehouses Warehouse[] @relation("WarehouseManager")

  createdProducts Product[] @relation("ProductCreatedBy")
  updatedProducts Product[] @relation("ProductUpdatedBy")
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
  OVERSTOCK
}

model Inventory {
  id Int @id @default(autoincrement())

  product_id Int
  product    Product @relation("ProductInventory", fields: [product_id], references: [id])

  warehouse_id Int
  warehouse    Warehouse @relation("WarehouseInventory", fields: [warehouse_id], references: [id])

  quantity            Decimal @default(0)
  reserved_quantity   Decimal @default(0)
  damaged_quantity    Decimal @default(0)
  quarantine_quantity Decimal @default(0)

  average_cost Decimal?
  last_cost    Decimal?

  minimum_stock    Decimal?
  maximum_stock    Decimal?
  reorder_point    Decimal?
  reorder_quantity Decimal?

  stock_status StockStatus @default(IN_STOCK)

  last_counted_at  DateTime?
  last_received_at DateTime?
  last_issued_at   DateTime?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  @@unique([product_id, warehouse_id])
}
